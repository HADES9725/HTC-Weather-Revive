# Android shell scripts and config files MUST keep LF line endings.
# CRLF breaks /system/bin/sh execution on-device.
* text=auto eol=lf

*.sh    text eol=lf
*.conf  text eol=lf
hosts   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.prop  text eol=lf

# CGI scripts without extension
module/common/scripts/search text eol=lf
module/common/scripts/jump   text eol=lf

# Binary files must not be touched
*.apk   binary
*.zip   binary
*.db    binary
busybox binary
